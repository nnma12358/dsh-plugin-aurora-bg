{
  "name": "dsh-plugin-aurora-bg",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "Aurora 背景 UI（桌面端移植版）：毛玻璃表面 + 自定义背景图 + 主色联动；带可视化面板，可用滑块逐个调节主内容列/卡片/侧栏/输入框等表面的透明度与背景模糊。",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "author": "nnma12358 (https://github.com/nnma12358)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nnma12358/dsh-plugin-aurora-bg.git"
  },
  "homepage": "https://github.com/nnma12358/dsh-plugin-aurora-bg#readme",
  "bugs": {
    "url": "https://github.com/nnma12358/dsh-plugin-aurora-bg/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness"
  ]
}
